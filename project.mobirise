        "main": true,
        "title": "Jupiter Swap | The Home of Onchain Finance.",
        "meta_descr": "Jupiter Swap is Solana\\'s leading DEX aggregator — a routing engine that simultaneously checks prices across 50+ Solana DEXes to find the best execution path for any token swap.",
